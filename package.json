  "peerDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": ">=10.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.0",
