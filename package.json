{
  "name": "@toreda/eslint-config",
  "version": "3.1.0",
  "description": "Toreda's shareable ESLint flat config for TypeScript and Prettier. Requires ESLint 9+.",
  "main": "index.js",
  "files": [
    "index.js",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toreda/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint9",
    "flat-config",
    "typescript",
    "typescript-eslint",
    "prettier",
    "shareable-config",
    "toreda"
  ],
  "author": "Toreda, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/toreda/eslint-config/issues"
  },
  "homepage": "https://github.com/toreda/eslint-config#readme",
  "peerDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-prettier": ">=9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
